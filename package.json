{
  "name": "lbj-lakehouse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:readonly": "tsc --noEmit && VITE_READONLY=true vite build",
    "deploy:firebase": "npm run build:readonly && firebase deploy --only hosting",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "takeoff": "tsx scripts/takeoff.ts",
    "textcheck": "tsx scripts/textcheck.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "immer": "^11.1.18",
    "jspdf": "^4.2.1",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.186.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
